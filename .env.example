# Weather Edge, configuration template.
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# `.env` is gitignored and MUST NEVER be committed. Most values below map to a
# field on Settings in src/weather_edge/config.py (pydantic-settings reads the
# UPPER_CASE env var of the same name from `.env`). The WE_DASHBOARD_* variables
# are the exception: they are read straight from the process environment, so
# export them in your shell rather than relying on `.env`. Nothing here is
# required to run the test suite or the read-only `forecast` / `markets` commands.
#
# Persistence is a local SQLite file (weather_edge.db in the repo root); there is
# no database server to configure.

# ─── Redis (optional) ────────────────────────────────────────────────────────
# Hot-path cache, kill switch and heartbeats when running the scheduler.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ─── AI reasoning layer (recommended) ────────────────────────────────────────
# Without these the pipeline still runs but the Claude/Gemini review steps are
# skipped ("AI reasoning will be degraded"). With REQUIRE_AI_REVIEW=true (the
# default) that also means no trades are placed.
# Claude (Meteorologist):  https://console.anthropic.com/  -> API Keys
ANTHROPIC_API_KEY=
# Gemini (Risk Quant):     https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Claude model id used for the Meteorologist review
CLAUDE_MODEL=claude-sonnet-5
# true = never place a trade on a signal without a successful AI review
REQUIRE_AI_REVIEW=true
# Paid Claude/Gemini reviews per main cycle
MAX_AI_REVIEWS_PER_CYCLE=3
# Oldest cached forecast (hours) the stale-data fallback may use
MAX_STALE_FORECAST_HOURS=6.0

# ─── Weather data (optional) ─────────────────────────────────────────────────
# Open-Meteo works on the free tier with no key. A customer key removes the
# inter-city rate-limit delay and enables parallel model fetches ($30/mo tier).
OPENMETEO_API_KEY=
OPENMETEO_PAID_TIER=false
# Free-tier endpoint (a set OPENMETEO_API_KEY switches to the customer endpoint)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# GribStream (optional): adds GraphCast / AIFS AI models. https://gribstream.com
GRIBSTREAM_API_KEY=

# ─── Strategy / sizing (have sane defaults; override only if you know why) ────
BANKROLL=2000.0
MIN_EDGE=0.05
MIN_CONFIDENCE=0.6
KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.03
FETCH_INTERVAL_MINUTES=30

# ─── Advanced tuning (defaults shown; uncomment only if you know why) ────────
# Entry limits
# MAX_BETS_PER_CITY_DATE=1
# MAX_TRADES_PER_CYCLE=6
# Pool allocation (fractions of bankroll)
# POOL_TODAY_PCT=0.35
# POOL_TOMORROW_PCT=0.25
# POOL_PENNY_PCT=0.40
# Penny sweep constraints
# PENNY_MIN_EDGE_MULTIPLIER=3.0
# PENNY_MIN_POSITION=10.0
# PENNY_MAX_POSITION=50.0
# PENNY_MAX_ENTRY_PRICE=0.05
# PENNY_ORDER_SPLIT_MAX_SHARES=5
# Tail-No strategy
# TAIL_NO_MAX_YES_MARKET_PROB=0.40
# TAIL_NO_MIN_EDGE=0.03
# Exits and consensus sanity
# MAX_SLIPPAGE_PCT=0.02
# MAX_CORE_ZSCORE=2.0
# SELL_HALF_GAIN_PCT=0.40
# SELL_HALF_MIN_USD=10.0
# SELL_HALF_EDGE_MAX=0.0

# ─── Trading modes ───────────────────────────────────────────────────────────
# Simulated paper trading (on by default)
PAPER_MODE=true
# Real-money trading on Polymarket. Leave false (see README status banner).
LIVE_MODE=false
# Max shares per live order, 0 = unlimited (set 5/20/50 for graduated testing)
LIVE_MAX_SHARES=0
# The 2026-04-07 rail-less lottery experiment, kept for the record. NEVER enable.
HAIL_MARY_MODE=false

# ─── Dashboard (read from the shell environment, not .env) ───────────────────
# Bind address. It has no authentication; keep 127.0.0.1 unless you front it
# with your own auth/proxy.
WE_DASHBOARD_HOST=127.0.0.1
# Comma-separated Host header values to accept. Empty = localhost only; if set,
# it REPLACES the localhost defaults (a specific WE_DASHBOARD_HOST is always added).
WE_DASHBOARD_ALLOWED_HOSTS=

# ─── On-chain whale tracking (optional, dormant unless both are set) ─────────
# Etherscan V2 API key (covers Polygon): https://etherscan.io/myapikey
POLYGONSCAN_API_KEY=
# Comma-separated wallets to watch, optionally labelled: label=0xabc...,0xdef...
WHALE_WALLETS=
# Comma-separated Polymarket usernames to compare P&L against on the dashboard
COMPETITOR_USERNAMES=

# ─── Live execution on Polymarket (DANGER, see README status banner) ────────
# Only needed to place REAL trades, which is NOT recommended (this bot lost 75%
# of its capital). Leave blank for paper trading. POLYMARKET_PRIVATE_KEY is the
# ONLY true secret here, it controls real funds. Never paste it anywhere public,
# never commit it, and prefer a fresh wallet with limited funds for any testing.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET=
# 2 = EOA wallet, 1 = Polymarket proxy / Magic Link
POLYMARKET_SIGNATURE_TYPE=2
# CLOB API credentials (create at https://polymarket.com/settings -> API)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# Relayer API key for gasless proxy-wallet redemption
POLYMARKET_RELAYER_API_KEY=
# Endpoints and chain (defaults are Polymarket production / Polygon mainnet)
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_URL=https://clob.polymarket.com
# POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
# POLYMARKET_CHAIN_ID=137
